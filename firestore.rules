rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "LHUcXRtau5hPYXRdRY5w5hopsP52";
    }

    function feedbackCreateFields() {
      return [
        "id",
        "userId",
        "userEmail",
        "type",
        "rating",
        "message",
        "page",
        "status",
        "createdAt"
      ];
    }

    function feedbackUpdateFields() {
      return [
        "status",
        "adminNote"
      ];
    }

    function isValidFeedbackType(feedbackType) {
      return feedbackType in ["bug", "feature_request", "general", "complaint", "praise"];
    }

    function isValidFeedbackStatus(feedbackStatus) {
      return feedbackStatus in ["new", "reviewed", "in_progress", "done"];
    }

    function hasValidFeedbackCreateData(feedbackId) {
      return request.resource.data.keys().hasOnly(feedbackCreateFields())
        && request.resource.data.keys().hasAll([
          "id",
          "userId",
          "userEmail",
          "type",
          "message",
          "page",
          "status",
          "createdAt"
        ])
        && request.resource.data.id == feedbackId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() > 0
        && isValidFeedbackType(request.resource.data.type)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.page is string
        && request.resource.data.page.size() > 0
        && request.resource.data.status == "new"
        && request.resource.data.createdAt is timestamp
        && (
          !request.resource.data.keys().hasAny(["rating"])
          || (
            request.resource.data.rating is number
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
          )
        );
    }

    function hasValidFeedbackUpdateData() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(feedbackUpdateFields())
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
          || isValidFeedbackStatus(request.resource.data.status)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["adminNote"])
          || (
            request.resource.data.adminNote is string
            && request.resource.data.adminNote.size() <= 1000
          )
        );
    }

    function subscriptionFields() {
      return [
        "currentPeriodEnd",
        "isProUser",
        "stripeCustomerId",
        "stripeSubscriptionId",
        "subscriptionPlan",
        "subscriptionStatus"
      ];
    }

    function doesNotChangeSubscriptionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(subscriptionFields());
    }

    function doesNotCreateSubscriptionFields() {
      return !request.resource.data.keys().hasAny(subscriptionFields());
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && doesNotCreateSubscriptionFields();
      allow update: if isOwner(userId) && doesNotChangeSubscriptionFields();
      allow delete: if false;

      match /trades/{tradeId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /expenses/{expenseId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /dailyReviews/{reviewId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /stats/{statsId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /aiUsage/{usageDate} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /aiConversations/{conversationId} {
        allow read: if isOwner(userId);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      match /reports/{reportId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(["month", "year", "generatedAt", "summary", "downloadUrl"])
          && request.resource.data.month is int
          && request.resource.data.year is int
          && request.resource.data.summary is map;
        allow update: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["userId", "type", "title", "message", "read", "createdAt"])
        && request.resource.data.type in ["info", "success", "warning", "danger"]
        && request.resource.data.read == false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() && hasValidFeedbackCreateData(feedbackId);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() && hasValidFeedbackUpdateData();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
